{
	"avali": {
		"Group": "beasts",
		"Icon": "avalirdx:icons/avali",
		"GroupIcon": "playermodellib:icons/beasts",
		"ShapePath": "avalirdx:entity/humanoid/avali-faceless",
		"MainTextureCode": "avalibodytex",
		"SizeRange": [ 0.6, 0.6 ],
		"ScaleColliderWithSizeHorizontally": true,
		"ScaleColliderWithSizeVertically": true,
		"MaxCollisionBox": [ 0.8, 2.7 ],
		"MinCollisionBox": [ 0.1, 0.1 ],
		"MaxEyeHeight":	1.1,
		"MinEyeHeight":	1.1,
        "SneakEyeHeightMultiplier": 0.7,
		"ExtraTraits": ["avali-nutrition", "avali-movement"],
		"AddTags": ["beasts","avali"],
		"RemoveTags": ["seraph"],
		"SkinnableParts": [
			{
				"code": "baseskin",
				"type": "texture",
				"textureTarget": "avalibodytex",
				"targetSkinParts": ["base", "chest","facialexpression"],
				"overlayTexture": false,
				"overlayMode": "Normal",
				"textureTemplate": "avalirdx:entity/humanoid/seraphskinparts/body/{code}",
				"variants": [
					{ "code": "avaliskin1", "texture": "skin1" }
				]
			},
			{
				"code": "facialexpression",
				"type": "shape",
				"shapeTemplate": { "base": "avalirdx:entity/humanoid/seraphskinparts/face/{code}" },
				"variants": [
					{ "code": "neutral"}
				]
			},
			{
				"code": "voicetype",
				"type": "voice", 
				"useDropDown": true,
				"variants": [
					{ "code": "altoflute", "sound": "sounds/voice/altoflute" },
					{ "code": "harmonica", "sound": "sounds/voice/harmonica" },
					{ "code": "oboe", "sound": "sounds/voice/oboe" },
					{ "code": "clarinet", "sound": "sounds/voice/clarinet" },
					{ "code": "accordion", "sound": "sounds/voice/accordion" },
					{ "code": "trumpet", "sound": "sounds/voice/trumpet" },
					{ "code": "sax", "sound": "sounds/voice/sax" },
					{ "code": "tuba", "sound": "sounds/voice/tuba" },
					{ "code": "frog", "sound": "avalirdx:sounds/voice/treefrog" },
					{ "code": "gecko", "sound": "avalirdx:sounds/voice/tokay" },
					{ "code": "meep", "sound": "avalirdx:sounds/voice/meep" },
					{ "code": "none", "sound": "avalirdx:sounds/voice/none" }
				]
			},
			{
				"code": "voicepitch",
				"type": "voice", 
				"useDropDown": true,
				"variants": [
					{ "code": "verylow" },
					{ "code": "low" },
					{ "code": "medium" },
					{ "code": "high" }
				]
			},
			{
				"code": "underwear",
				"type": "texture", 
				"useDropDown": true,
				"textureTarget": "avalibodytex",
				"targetSkinParts": ["base", "chest"],
				"overlayTexture": true,
				"overlayMode": "normal",
				"textureTemplate": "avalirdx:entity/humanoid/seraphskinparts/underwear/{code}",
				"variants": [
					{ "code": "none", "texture": "none" }
				]
			},
			{
				"code": "chest",
				"type": "shape",
				"shapeTemplate": { "base": "avalirdx:entity/humanoid/seraphskinparts/chest/{code}" },
				"variants": [
					{ "code": "none"}
				],
				"disableElementsByVariantCode": {
					"none": ["*Breasts-clothes", "*Breasts-clothing", "*Breasts-armor"],
					"yes": []
				}
			}
		]
	}
}